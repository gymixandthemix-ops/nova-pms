        "bullmq": "^5.53.2",
        "fastify": "^5.3.2",
        "ioredis": "^5.6.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "prisma": "6.8.2",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3",
        "vitest": "^3.1.1"
    }
}